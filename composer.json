{
    "name": "tigusigalpa/whale-alert-php",
    "description": "Unofficial PHP client library for the Whale Alert Enterprise API",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "whale-alert",
        "crypto",
        "blockchain",
        "api",
        "sdk",
        "laravel"
    ],
    "authors": [
        {
            "name": "Igor Sazonov",
            "email": "sovletig@gmail.com",
            "homepage": "https://github.com/tigusigalpa"
        }
    ],
    "require": {
        "php": "^8.1",
        "guzzlehttp/guzzle": "^7.15.2",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0 || ^11.0",
        "guzzlehttp/psr7": "^2.13.1",
        "league/commonmark": "^2.10.1",
        "orchestra/testbench": "^10.0 || ^11.0",
        "phpstan/phpstan": "^2.1"
    },
    "autoload": {
        "psr-4": {
            "Tigusigalpa\\WhaleAlert\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tigusigalpa\\WhaleAlert\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Tigusigalpa\\WhaleAlert\\Laravel\\WhaleAlertServiceProvider"
            ],
            "aliases": {
                "WhaleAlert": "Tigusigalpa\\WhaleAlert\\Laravel\\WhaleAlertFacade"
            }
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
